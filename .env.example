# Copy to .env.local for local development, and add the same variables in your hosting provider (e.g. Vercel).
# Never commit real values.

# ── Site ─────────────────────────────────────────────
# Final public domain, no trailing slash. Used for canonical URLs, sitemap, Open Graph and structured data.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# ── Form storage (recommended: Supabase) ─────────────
# Without these, submissions are saved to .data/submissions.json in development only.
# In production, forms need storage OR email configured; otherwise they honestly report "not connected".
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_TABLE=submissions

# ── Email notifications (Resend) ─────────────────────
RESEND_API_KEY=
# Where new submissions are sent:
NOTIFY_EMAIL_TO=
# Sender on a domain you verified in Resend, e.g. "MANO Website <hello@your-domain.com>"
NOTIFY_EMAIL_FROM=
# Also send visitors a short "received / pending confirmation" email (true/false):
SEND_VISITOR_ACK=false

# ── Private inbox at /admin ──────────────────────────
# /admin returns 404 unless ADMIN_PASSWORD is set. Use a long random value.
ADMIN_USER=admin
ADMIN_PASSWORD=
