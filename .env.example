# Copy to .env.local for local development, and add the same variables in your hosting provider (e.g. Vercel).
# Never commit real values.

# ── Site ─────────────────────────────────────────────
# Final public domain, no trailing slash. Used for canonical URLs, sitemap, Open Graph and structured data.
# Optional on Vercel: falls back to the Vercel production domain automatically.
NEXT_PUBLIC_SITE_URL=

# ── Form storage (recommended: Supabase) ─────────────
# Without these, submissions are saved to .data/submissions.json in development only.
# In production, forms need storage OR email configured; otherwise they honestly report "not connected".
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_TABLE=submissions

# ── Email notifications (Resend) ─────────────────────
RESEND_API_KEY=
# Where new submissions are sent:
NOTIFY_EMAIL_TO=
# Sender on a domain you verified in Resend, e.g. "MANO Website <hello@your-domain.com>"
NOTIFY_EMAIL_FROM=
# Also send visitors a short "received / pending confirmation" email (true/false):
SEND_VISITOR_ACK=false

# ── Private inbox at /admin ──────────────────────────
# /admin returns 404 unless ADMIN_PASSWORD is set. Use a long random value.
ADMIN_USER=admin
ADMIN_PASSWORD=

# ── Free tools (AI) ──────────────────────────────────
# Anthropic API key, server-only. Without it, the Website Audit runs its measured checks only and the Planner is shown as unavailable.
ANTHROPIC_API_KEY=
# Model for the tools (default claude-opus-5-5).
# TOOLS_MODEL=claude-opus-5-5
# Shared rate limits + daily cost ceiling (free Upstash Redis). REQUIRED for AI features in production.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Runs per visitor per tool per day, and total AI runs per day across all tools.
TOOLS_PER_VISITOR_DAILY=3
TOOLS_AI_DAILY_LIMIT=60
# Set to true to switch AI off instantly without a redeploy of code.
# TOOLS_AI_DISABLED=false
